        "user_env": "MERIDA_USER",
        "password_env": "MERIDA_PASSWORD",
        "opt_insecure": false
    },
    "paths": {
        "root": "${WCM_DATA_ROOT}/study_sites/Ceregnano",
        "data_output": {
            "folder_monthly": "merida/monthly/",
            "filename_monthly": "MERIDA_HRES_{variable}_{yyyymm}.nc",
            "folder_merged": "merida/",
            "filename_merged": "MERIDA_{label}_{start}-{end}.nc"
        }
    }
